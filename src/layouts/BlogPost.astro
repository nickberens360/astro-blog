---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags = [] } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Canonical URL: this page's own path on the configured site (astro.config.mjs `site`)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL - establishes this blog as source of truth -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Critical for Medium Import -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Clean styling optimized for Medium import -->
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        background: #fff;
      }

      article {
        max-width: 680px;
        margin: 0 auto;
        padding: 4rem 2rem;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        line-height: 1.2;
      }

      .meta {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #eee;
      }

      .tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
      }

      .tag {
        background: #f4f4f4;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #666;
      }

      h2 {
        font-size: 1.8rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 600;
      }

      h3 {
        font-size: 1.4rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
      }

      p {
        margin-bottom: 1.5rem;
        font-size: 1.05rem;
      }

      ul, ol {
        margin-bottom: 1.5rem;
        padding-left: 2rem;
      }

      li {
        margin-bottom: 0.5rem;
      }

      pre {
        background: #f6f8fa;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        border: 1px solid #e1e4e8;
      }

      code {
        background: #f6f8fa;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-size: 0.9em;
        font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
      }

      pre code {
        background: none;
        padding: 0;
      }

      blockquote {
        border-left: 4px solid #ddd;
        padding-left: 1.5rem;
        margin: 1.5rem 0;
        color: #666;
        font-style: italic;
      }

      a {
        color: #0066cc;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      img {
        max-width: 100%;
        height: auto;
        margin: 1.5rem 0;
      }

      details {
        position: relative;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        background: #fafbfc;
      }

      details[open] {
        padding-bottom: 0.25rem;
      }

      summary {
        cursor: pointer;
        padding-right: 5rem;
      }

      details[open] > summary {
        margin-bottom: 1rem;
      }

      .copy-btn {
        position: absolute;
        top: 0.6rem;
        right: 0.75rem;
        font: inherit;
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        border: 1px solid #d0d7de;
        border-radius: 4px;
        background: #fff;
        color: #333;
        cursor: pointer;
      }

      .copy-btn:hover {
        background: #f3f4f6;
      }
    </style>
  </head>
  <body>
    <article>
      <h1>{title}</h1>
      <div class="meta">
        <div>{formattedDate}</div>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      <slot />
    </article>
    <script>
      // Add a copy button to every accordion marked with data-copy.
      // If the accordion holds a code block, copy that; otherwise copy its text.
      document.querySelectorAll('article details[data-copy]').forEach((details) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.textContent = 'Copy';
        button.addEventListener('click', async (event) => {
          event.preventDefault();
          event.stopPropagation();
          const pre = details.querySelector('pre');
          let text;
          if (pre) {
            text = pre.textContent ?? '';
          } else {
            const wasOpen = details.open;
            details.open = true;
            text = Array.from(details.children)
              .filter((el) => el.tagName !== 'SUMMARY' && !el.classList.contains('copy-btn'))
              .map((el) => (el as HTMLElement).innerText)
              .join('\n\n');
            details.open = wasOpen;
          }
          try {
            await navigator.clipboard.writeText(text.trim());
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Copy failed';
          }
          setTimeout(() => (button.textContent = 'Copy'), 2000);
        });
        // Inside the summary so it stays visible while the accordion is closed.
        details.querySelector('summary')?.appendChild(button);
      });
    </script>
  </body>
</html>
